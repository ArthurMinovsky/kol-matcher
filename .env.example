# Optional. No credentials are required for the deterministic Dr. Pong demo.
TYPHOON_API_KEY=
GEMINI_API_KEY=

# Optional official TikTok Research API access.
TIKTOK_RESEARCH_API_TOKEN=
TIKTOK_RESEARCH_API_BASE_URL=https://open.tiktokapis.com

# Optional browser fallback; disabled by default. CDP can point to Lightpanda.
TIKTOK_BROWSER_ENABLED=false
TIKTOK_BROWSER_CDP_URL=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://kol-matcher.vercel.app,https://web-beta-six-97.vercel.app

# Optional matching laboratory. Set a strong local value before starting the
# matching-lab Compose profile; do not commit the value.
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SUPERUSER=langflow
